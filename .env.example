NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Optional Local override. If empty, NEXT_PUBLIC_SITE_URL is used.
NEXT_PUBLIC_DEV_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=
# Canonical public key. One of the two public key variables is required.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias kept for compatibility and selected before the publishable key when both exist.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase key. Leave empty in examples and set only in local or hosted secrets.
SUPABASE_SERVICE_ROLE_KEY=

# Optional item-photo AI Vision extension. The API key must stay server-only.
ITEM_PHOTO_AI_PROVIDER=groq
ITEM_PHOTO_AI_MODEL=
GROQ_API_KEY=

# Local development and E2E test configuration.
E2E_BASE_URL=http://127.0.0.1:3000
E2E_PASSWORD=
