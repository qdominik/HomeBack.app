NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Optional Local override. If empty, NEXT_PUBLIC_SITE_URL is used.
NEXT_PUBLIC_DEV_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=
# Canonical public key. One of the two public key variables is required.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias kept for compatibility and selected before the publishable key when both exist.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase key. Leave empty in examples and set only in local or hosted secrets.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only kill switch for invitation mutations. Enabled only by the exact value true.
HOUSEHOLD_INVITATIONS_ENABLED=false

# Server-only invitation e-mail configuration. Keep real credentials outside the repository.
APP_BASE_URL=http://127.0.0.1:3000
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=HomeBack <noreply@homeback.app>
# Comma-separated exact addresses allowed for real Preview sends.
INVITATION_EMAIL_ALLOWLIST=
# Local/E2E only. Hosted environments use smtp.
INVITATION_EMAIL_TRANSPORT=smtp

# Optional item-photo AI Vision extension. The API key must stay server-only.
ITEM_PHOTO_AI_PROVIDER=groq
ITEM_PHOTO_AI_MODEL=
GROQ_API_KEY=

# Local development and E2E test configuration.
E2E_BASE_URL=http://127.0.0.1:3000
E2E_PASSWORD=
